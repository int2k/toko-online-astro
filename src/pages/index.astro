---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import { formatRupiah } from '../lib/format';
import { getProductImageUrl, getProducts } from '../lib/products';

// Data diambil saat build, jadi situs tetap statik (tanpa adapter SSR).
const { products, error } = await getProducts();
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Katalog produk Toko Online Gratis — belanja mudah dengan harga terbaik."
		/>
		<title>Katalog Produk | Toko Online Gratis</title>
	</head>
	<body>
		<SiteHeader />

		<main class="container">
			<section class="intro">
				<p class="eyebrow">Selamat datang</p>
				<h1>Katalog Produk</h1>
				<p class="lead">
					Lihat pilihan produk kami. Semua harga ditampilkan dalam Rupiah.
				</p>
			</section>

			{
				error && (
					<p class="notice" role="status">
						Produk belum dapat dimuat dari Supabase. Periksa koneksi dan izin
						tabel <code>products</code>, lalu jalankan build ulang.
					</p>
				)
			}

			{
				products.length === 0 ? (
					<p class="empty" role="status">
						Belum ada produk untuk ditampilkan.
					</p>
				) : (
					<ul class="product-grid">
						{products.map((product) => (
							<li>
								<a class="card" href={`/produk/${product.slug}`}>
									<div class="media">
										{product.image_url ? (
											<img
												src={getProductImageUrl(product.image_url) ?? undefined}
												alt={product.name}
												loading="lazy"
											/>
										) : (
											<div class="placeholder" aria-hidden="true">
												<svg
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="1.5"
												>
													<rect x="3" y="3" width="18" height="18" rx="2" />
													<circle cx="8.5" cy="8.5" r="1.5" />
													<path d="m21 15-5-5L5 21" />
												</svg>
											</div>
										)}
									</div>
									<div class="card-body">
										<h2>{product.name}</h2>
										<p class="price">{formatRupiah(product.price)}</p>
										<span class="detail-hint">Lihat detail →</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</main>

		<footer class="site-footer">
			<div class="container">
				<p>Toko Online Gratis · Dibangun dengan Astro dan Supabase</p>
			</div>
		</footer>

		<style>
			.intro {
				padding-block: 3rem 2rem;
			}

			.eyebrow {
				margin: 0 0 0.5rem;
				color: #166534;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			h1 {
				margin: 0;
				font-size: clamp(2rem, 5vw, 2.75rem);
				line-height: 1.15;
				letter-spacing: -0.02em;
			}

			.lead {
				max-width: 36rem;
				margin: 0.75rem 0 0;
				color: #6b6862;
			}

			.notice,
			.empty {
				padding: 1rem 1.25rem;
				border-radius: 0.75rem;
				margin: 0 0 1.5rem;
				font-size: 0.9375rem;
			}

			.notice {
				background: #fff7e6;
				border: 1px solid #f2dcb3;
				color: #7a5310;
			}

			.empty {
				background: #fff;
				border: 1px dashed #d9d5cc;
				color: #6b6862;
			}

			.product-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
				gap: 1.25rem;
				padding: 0;
				margin: 0 0 3rem;
				list-style: none;
			}

			.card {
				overflow: hidden;
				display: flex;
				flex-direction: column;
				height: 100%;
				color: inherit;
				text-decoration: none;
				background: #fff;
				border: 1px solid #e7e4dd;
				border-radius: 1rem;
				box-shadow: 0 1px 2px rgb(28 27 25 / 4%);
				transition:
					transform 160ms ease,
					box-shadow 160ms ease;
			}

			.card:hover {
				transform: translateY(-3px);
				box-shadow: 0 12px 28px rgb(28 27 25 / 9%);
			}

			.card:focus-visible {
				outline: 3px solid #166534;
				outline-offset: 3px;
			}

			.media {
				aspect-ratio: 4 / 3;
				background: #efede7;
			}

			.media img,
			.placeholder {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.placeholder svg {
				width: 3rem;
				height: 3rem;
			}

			.card-body {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				padding: 1rem 1.1rem 1.2rem;
			}

			.card-body h2 {
				margin: 0;
				font-size: 1rem;
				line-height: 1.35;
			}

			.price {
				margin: auto 0 0;
				color: #166534;
				font-size: 1.15rem;
				font-weight: 700;
			}

			.detail-hint {
				color: #6b6862;
				font-size: 0.8rem;
			}

			@media (prefers-reduced-motion: reduce) {
				.card {
					transition: none;
				}
			}
		</style>
	</body>
</html>
