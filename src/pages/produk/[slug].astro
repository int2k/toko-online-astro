---
import {
	formatRupiah,
	getProductImageUrl,
	getProducts,
	type Product,
} from '../../lib/products';

interface Props {
	product: Product;
}

// Semua halaman detail dibuat statis saat build dari tabel products.
export async function getStaticPaths() {
	const { products, error } = await getProducts();

	// Gagal build lebih baik daripada situs kosong yang lolos deploy.
	if (error) {
		throw new Error(
			`Gagal mengambil produk dari Supabase saat build: ${error.message}. ` +
				'Periksa koneksi dan status proyek Supabase, lalu jalankan build ulang.',
		);
	}

	return products.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

const { product } = Astro.props;
const imageUrl = getProductImageUrl(product.image_url);
const description = product.description?.trim() || 'Deskripsi belum tersedia untuk produk ini.';
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{product.name} | Toko Online Gratis</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/">
					<span class="brand-mark" aria-hidden="true">✦</span>
					<span>Toko Online Gratis</span>
				</a>
				<span class="header-note">Belanja sederhana, harga bersahabat</span>
			</div>
		</header>

		<main class="container">
			<nav class="breadcrumb" aria-label="Navigasi">
				<a href="/">Katalog</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{product.name}</span>
			</nav>

			<article class="detail">
				<div class="media">
					{
						imageUrl ? (
							<img src={imageUrl} alt={product.name} />
						) : (
							<div class="placeholder" aria-hidden="true">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
								>
									<rect x="3" y="3" width="18" height="18" rx="2" />
									<circle cx="8.5" cy="8.5" r="1.5" />
									<path d="m21 15-5-5L5 21" />
								</svg>
							</div>
						)
					}
				</div>

				<div class="info">
					<p class="eyebrow">Detail produk</p>
					<h1>{product.name}</h1>
					<p class="price">{formatRupiah(product.price)}</p>

					<section class="description">
						<h2>Deskripsi</h2>
						<p>{description}</p>
					</section>

					<a class="back" href="/">← Kembali ke katalog</a>
				</div>
			</article>
		</main>

		<footer class="site-footer">
			<div class="container">
				<p>Toko Online Gratis · Dibangun dengan Astro dan Supabase</p>
			</div>
		</footer>

		<style>
			:global(*) {
				box-sizing: border-box;
			}

			:global(body) {
				margin: 0;
				background: #f8f7f4;
				color: #1c1b19;
				font-family:
					system-ui,
					-apple-system,
					'BlinkMacSystemFont',
					'Segoe UI',
					sans-serif;
				line-height: 1.5;
			}

			.container {
				width: min(100% - 2rem, 72rem);
				margin-inline: auto;
			}

			.site-header {
				background: #fff;
				border-bottom: 1px solid #e7e4dd;
			}

			.header-inner {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				padding-block: 1rem;
			}

			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: inherit;
				font-weight: 700;
				font-size: 1.05rem;
				text-decoration: none;
			}

			.brand-mark {
				display: grid;
				place-items: center;
				width: 2rem;
				height: 2rem;
				border-radius: 0.65rem;
				background: #166534;
				color: #fff;
				font-size: 1rem;
			}

			.header-note {
				color: #6b6862;
				font-size: 0.875rem;
			}

			.breadcrumb {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-items: center;
				padding-block: 1.5rem 0;
				color: #6b6862;
				font-size: 0.875rem;
			}

			.breadcrumb a {
				color: #166534;
			}

			.detail {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
				gap: clamp(1.5rem, 4vw, 3rem);
				padding-block: 1.5rem 4rem;
				align-items: start;
			}

			.media {
				aspect-ratio: 4 / 3;
				overflow: hidden;
				background: #efede7;
				border: 1px solid #e7e4dd;
				border-radius: 1rem;
			}

			.media img,
			.placeholder {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.placeholder {
				display: grid;
				place-items: center;
				color: #a9a49a;
			}

			.placeholder svg {
				width: 4rem;
				height: 4rem;
			}

			.eyebrow {
				margin: 0 0 0.5rem;
				color: #166534;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			h1 {
				margin: 0;
				font-size: clamp(2rem, 5vw, 2.75rem);
				line-height: 1.15;
				letter-spacing: -0.02em;
			}

			.price {
				margin: 1rem 0 0;
				color: #166534;
				font-size: 1.75rem;
				font-weight: 700;
			}

			.description {
				margin-top: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid #e7e4dd;
			}

			.description h2 {
				margin: 0 0 0.5rem;
				font-size: 1.1rem;
			}

			.description p {
				margin: 0;
				color: #4d4a45;
			}

			.back {
				display: inline-block;
				margin-top: 2rem;
				color: #166534;
				font-weight: 600;
			}

			.site-footer {
				border-top: 1px solid #e7e4dd;
				padding-block: 1.5rem;
				color: #6b6862;
				font-size: 0.875rem;
			}

			.site-footer p {
				margin: 0;
			}
		</style>
	</body>
</html>
