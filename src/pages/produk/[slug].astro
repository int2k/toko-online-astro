---
import SiteHeader from '../../components/SiteHeader.astro';
import '../../styles/global.css';
import { formatRupiah } from '../../lib/format';
import { getProductImageUrl, getProducts, type Product } from '../../lib/products';

interface Props {
	product: Product;
}

// Semua halaman detail dibuat statis saat build dari tabel products.
export async function getStaticPaths() {
	const { products, error } = await getProducts();

	// Gagal build lebih baik daripada situs kosong yang lolos deploy.
	if (error) {
		throw new Error(
			`Gagal mengambil produk dari Supabase saat build: ${error.message}. ` +
				'Periksa koneksi dan status proyek Supabase, lalu jalankan build ulang.',
		);
	}

	return products.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

const { product } = Astro.props;
const imageUrl = getProductImageUrl(product.image_url);
const description = product.description?.trim() || 'Deskripsi belum tersedia untuk produk ini.';
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{product.name} | Toko Online Gratis</title>
	</head>
	<body>
		<SiteHeader />

		<main class="container">
			<nav class="breadcrumb" aria-label="Navigasi">
				<a href="/">Katalog</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{product.name}</span>
			</nav>

			<article class="detail">
				<div class="media">
					{
						imageUrl ? (
							<img src={imageUrl} alt={product.name} />
						) : (
							<div class="placeholder" aria-hidden="true">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
								>
									<rect x="3" y="3" width="18" height="18" rx="2" />
									<circle cx="8.5" cy="8.5" r="1.5" />
									<path d="m21 15-5-5L5 21" />
								</svg>
							</div>
						)
					}
				</div>

				<div class="info">
					<p class="eyebrow">Detail produk</p>
					<h1>{product.name}</h1>
					<p class="price">{formatRupiah(product.price)}</p>

					<button
						id="tambah-keranjang"
						class="tambah-keranjang"
						type="button"
						data-slug={product.slug}
						data-name={product.name}
						data-price={product.price}
						data-image={imageUrl ?? ''}
					>
						Tambah ke keranjang
					</button>
					<p class="cart-feedback" role="status" data-cart-feedback hidden>
						Produk ditambahkan ke keranjang.
					</p>

					<section class="description">
						<h2>Deskripsi</h2>
						<p>{description}</p>
					</section>

					<a class="back" href="/">← Kembali ke katalog</a>
				</div>
			</article>
		</main>

		<footer class="site-footer">
			<div class="container">
				<p>Toko Online Gratis · Dibangun dengan Astro dan Supabase</p>
			</div>
		</footer>

		<script>
			import { tambahItem } from '../../lib/keranjang';

			const tombol = document.querySelector<HTMLButtonElement>('#tambah-keranjang');
			const umpan = document.querySelector<HTMLElement>('[data-cart-feedback]');

			tombol?.addEventListener('click', () => {
				const { slug, name, price, image } = tombol.dataset;
				if (!slug || !name) return;

				tambahItem({
					slug,
					name,
					price: Number(price),
					image: image ?? '',
				});

				if (umpan) {
					umpan.hidden = false;
					window.setTimeout(() => {
						umpan.hidden = true;
					}, 2500);
				}
			});
		</script>

		<style>
			.detail {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
				gap: clamp(1.5rem, 4vw, 3rem);
				padding-block: 1.5rem 4rem;
				align-items: start;
			}

			.media {
				aspect-ratio: 4 / 3;
				overflow: hidden;
				background: #efede7;
				border: 1px solid #e7e4dd;
				border-radius: 1rem;
			}

			.media img,
			.placeholder {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.placeholder svg {
				width: 4rem;
				height: 4rem;
			}

			.eyebrow {
				margin: 0 0 0.5rem;
				color: #166534;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			h1 {
				margin: 0;
				font-size: clamp(2rem, 5vw, 2.75rem);
				line-height: 1.15;
				letter-spacing: -0.02em;
			}

			.price {
				margin: 1rem 0 0;
				color: #166534;
				font-size: 1.75rem;
				font-weight: 700;
			}

			.tambah-keranjang {
				margin-top: 1.5rem;
				padding: 0.8rem 1.4rem;
				width: fit-content;
				border: 0;
				border-radius: 0.75rem;
				background: #166534;
				color: #fff;
				font: inherit;
				font-weight: 700;
				cursor: pointer;
			}

			.tambah-keranjang:hover {
				background: #14532d;
			}

			.tambah-keranjang:focus-visible {
				outline: 3px solid #166534;
				outline-offset: 3px;
			}

			.cart-feedback {
				margin: 0.75rem 0 0;
				color: #166534;
				font-size: 0.9rem;
				font-weight: 600;
			}

			.description {
				margin-top: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid #e7e4dd;
			}

			.description h2 {
				margin: 0 0 0.5rem;
				font-size: 1.1rem;
			}

			.description p {
				margin: 0;
				color: #4d4a45;
			}

			.back {
				display: inline-block;
				margin-top: 2rem;
				color: #166534;
				font-weight: 600;
			}

		</style>
	</body>
</html>
