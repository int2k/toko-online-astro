# Salin ke .env lalu isi dari Supabase Dashboard → Project Settings → API.
# Jangan pernah commit file .env.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_KEY=isi-publishable-key-di-sini
# Nama bucket Storage publik untuk gambar produk (opsional, default: products)
PUBLIC_SUPABASE_STORAGE_BUCKET=products
# Nomor WhatsApp penjual untuk checkout. Format 628xxxxxxxxxx — tanpa tanda + dan tanpa 0 di depan.
# Wajib diisi: build akan gagal kalau kosong. Ganti contoh di bawah dengan nomor asli.
PUBLIC_WHATSAPP_NUMBER=
